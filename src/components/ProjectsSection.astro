---
// 精选项目：3 列卡片网格，每张卡片含图标/标题/描述/技术栈与元信息
// 数据从集中配置读取，后续可改为从 GitHub API 动态拉取
import { siteConfig } from '../data/config';

const { projects } = siteConfig;
---

<section id="projects" class="scroll-mt-24 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center" style="font-size:var(--personal-font-size-h2);font-weight:var(--personal-font-weight-h2);line-height:var(--personal-line-height-h2)">精选项目</h2>
    <p class="mt-3 text-center text-[var(--personal-muted-foreground)]" style="font-size:var(--personal-font-size-body);line-height:var(--personal-line-height-body)">记录那些投入了时间与热忱的作品</p>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3" data-cfg-list="projects">
      {projects.map((p, i) => {
        const hasUrl = !!p.url;
        return (
          <a
            class="group flex flex-col rounded-xl border border-[var(--personal-border)] bg-[var(--personal-card)] p-5 no-underline transition-colors hover:border-[var(--personal-primary)]"
            data-cfg-card={`projects.${i}`}
            data-cfg-row
            data-cfg-row-prefix={`projects.${i}`}
            href={p.url}
            target={hasUrl ? '_blank' : undefined}
            rel={hasUrl ? 'noopener noreferrer' : undefined}
          >
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-[var(--personal-muted-foreground)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              <h3 class="text-[var(--personal-foreground)]" style="font-size:var(--personal-font-size-h4);font-weight:var(--personal-font-weight-h3);line-height:var(--personal-line-height-h3)" data-cfg={`projects.${i}.title`}>{p.title}</h3>
            </div>
            <p class="mt-3 line-clamp-2 flex-1 text-[var(--personal-muted-foreground)]" style="font-size:var(--personal-font-size-mono);line-height:var(--personal-line-height-body)" data-cfg={`projects.${i}.desc`}>{p.desc}</p>
            <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4 text-[var(--personal-muted-foreground)]" style="font-family:var(--personal-font-display);font-size:var(--personal-font-size-caption)">
              <span class="flex items-center gap-1" data-cfg-row data-cfg-row-prefix={`projects.${i}.lang`}><i data-lucide="code-2" class="h-3.5 w-3.5"></i><span data-cfg={`projects.${i}.lang`}>{p.lang}</span></span>
              <span class="flex items-center gap-1" data-cfg-row data-cfg-row-prefix={`projects.${i}.stars`}><i data-lucide="star" class="h-3.5 w-3.5"></i><span data-cfg={`projects.${i}.stars`}>{p.stars}</span></span>
              <span class="flex items-center gap-1" data-cfg-row data-cfg-row-prefix={`projects.${i}.year`}><i data-lucide="clock" class="h-3.5 w-3.5"></i><span data-cfg={`projects.${i}.year`}>{p.year}</span></span>
              <span class="flex items-center gap-1" data-cfg-row data-cfg-row-prefix={`projects.${i}.license`}><i data-lucide="scale" class="h-3.5 w-3.5"></i><span data-cfg={`projects.${i}.license`}>{p.license}</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
