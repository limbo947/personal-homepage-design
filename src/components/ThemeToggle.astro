---
// 主题切换按钮：点击在 light / dark 间切换，状态写入 localStorage，
// 由 DefaultLayout 顶部内联脚本在首屏前应用，避免闪烁
---

<button
  type="button"
  id="theme-toggle"
  aria-label="切换主题"
  class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--personal-card)] text-[var(--personal-muted-foreground)] shadow-[var(--personal-shadow-card)] transition-colors hover:text-[var(--personal-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--personal-primary)]"
>
  <!-- 暗色时显示太阳（点击切回亮），亮色时显示月亮（点击切到暗） -->
  <i data-lucide="sun" class="hidden h-4 w-4 dark:block"></i>
  <i data-lucide="moon-star" class="block h-4 w-4 dark:hidden"></i>
</button>

<script>
  // 直接绑定按钮 click：切换 html.dark class 并持久化到 localStorage
  // 放在 DOMContentLoaded 后执行，确保按钮已存在于 DOM
  function bindThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindThemeToggle);
  } else {
    bindThemeToggle();
  }
</script>
