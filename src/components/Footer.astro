---
import { siteConfig } from '../data/config';

const { footer, site } = siteConfig;
const year = new Date().getFullYear();
---

<footer id="contact" class="scroll-mt-24 bg-[var(--personal-card)] pt-10 pb-6">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-6 text-center">
    <p class="text-[var(--personal-muted-foreground)]" style="font-size:var(--personal-font-size-body);line-height:var(--personal-line-height-body)">© {year} <span data-cfg="site.author">{site.author}</span></p>
    <p style="font-size:var(--personal-font-size-body);font-weight:var(--personal-font-weight-h3);line-height:var(--personal-line-height-body)" data-cfg="footer.motto">{footer.motto}</p>
    {footer.icp && footer.icp.length > 0 && (
      <div class="mt-1 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[var(--personal-muted-foreground)]" style="font-size:var(--personal-font-size-caption)">
        {footer.icp.map(item => (
          <a href={item.url} target="_blank" rel="noopener" class="transition-colors hover:text-[var(--personal-primary)]">{item.label}</a>
        ))}
      </div>
    )}
  </div>
</footer>
