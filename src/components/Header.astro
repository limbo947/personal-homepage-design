---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../data/config';

// 导航菜单与品牌名均从集中配置读取，新增页面时改 config 即可
const { nav: menuItems, site } = siteConfig;
---

<header class="relative z-50">
  <nav id="site-nav" class="fixed inset-x-4 top-4 z-50 mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-lg border border-[var(--personal-border)] px-5 py-3 backdrop-blur-md site-nav">
    <a href="#about" class="transition-colors hover:text-[var(--personal-primary)]" style="font-size:var(--personal-font-size-body);font-weight:var(--personal-font-weight-h3)">
      <span data-cfg="site.author">{site.author}</span>
    </a>
    <div class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-7 md:flex">
      {menuItems.map(item => (
        <a
          href={item.href}
          class="text-[var(--personal-muted-foreground)] transition-colors hover:text-[var(--personal-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--personal-primary)]"
          style="font-size:var(--personal-font-size-body)"
        >{item.label}</a>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <ThemeToggle />
    </div>
  </nav>
</header>
