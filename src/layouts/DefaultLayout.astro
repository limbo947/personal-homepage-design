---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EditPanel from '../components/EditPanel.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

import { siteConfig } from '../data/config';

// 默认值取自集中配置，调用方仍可通过 props 覆盖
const { title = siteConfig.site.title, description = siteConfig.site.description } = Astro.props;

// 主题数据：SSG 时序列化为 JSON 注入页面，供 theme-apply.js 作为 base 合并覆盖
const themeInit = siteConfig.theme ?? null;

// 站点绝对地址：用于 canonical 与社交分享链接，缺失时回退到相对路径
const siteUrl = (siteConfig.site.url ?? '').replace(/\/$/, '');
// 社交分享图片：优先取首屏照片，构造为绝对 URL 供 OG/Twitter 抓取
const ogImage = siteUrl && siteConfig.hero.image
  ? `${siteUrl}${siteConfig.hero.image}`
  : `${siteUrl}/favicon.png`;
// 结构化数据：WebSite + Person 双重描述，利于搜索引擎理解站点归属与作者
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.site.title,
  description: siteConfig.site.description,
  ...(siteUrl ? { url: siteUrl } : {}),
  author: {
    '@type': 'Person',
    name: siteConfig.site.author,
  },
});
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={siteConfig.site.author} />
  <meta name="generator" content="Astro" />
  <!-- 规范链接：避免 www/非 www 等变体被搜索引擎视为重复内容 -->
  {siteUrl && <link rel="canonical" href={siteUrl} />}

  <!-- Open Graph：控制微信、Facebook 等社交平台分享时展示的标题/描述/图片 -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteConfig.site.title} />
  <meta property="og:locale" content="zh_CN" />
  {siteUrl && <meta property="og:url" content={siteUrl} />}
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card：控制 Twitter/X 分享卡片样式 -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- 结构化数据：WebSite 描述，便于搜索引擎丰富摘要展示 -->
  <script type="application/ld+json" set:html={jsonLd} />
  <!-- 主题初始化：尽早同步执行，避免明暗切换时闪烁（FOUC） -->
  <script is:inline>
    (function () {
      var saved = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var isDark = saved === 'dark' || (!saved && prefersDark);
      if (isDark) document.documentElement.classList.add('dark');
    })();
  </script>
  <!-- 主题初始数据：SSG 注入，theme-apply.js 读取后合并 localStorage 覆盖 -->
  {themeInit && (
    <script id="theme-init" type="application/json" set:html={JSON.stringify(themeInit)} />
  )}
  <!-- 色阶派生 + 主题应用：同步加载，在 head 中尽早执行避免 FOUC -->
  <!-- 生产环境也需从 config.yaml 应用主题；dev 期额外读 localStorage 覆盖 -->
  <script is:inline src="/scripts/theme-derive.js"></script>
  <script is:inline src="/scripts/theme-apply.js"></script>
  <!-- 配置覆盖：dev 期同步加载，DOMContentLoaded 后立即应用 localStorage 中的本地覆盖，避免文本闪烁 -->
  <!-- 生产环境无编辑面板，不会产生 localStorage 覆盖，此脚本不加载以减少产物体积 -->
  {import.meta.env.DEV && <script is:inline src="/scripts/cfg-apply.js"></script>}
</head>
<body class="min-h-screen font-sans antialiased">
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  {/* 编辑面板仅在 dev 模式渲染，生产构建不输出任何 HTML，普通访客不可见 */}
  {import.meta.env.DEV && <EditPanel />}

  <!-- Lucide 图标渲染：按需导入生产 15 个图标 + dev 额外 8 个编辑面板图标 -->
  <!-- dev 图标只在 import.meta.env.DEV 块中使用，生产构建时 Rollup tree-shake 移除 -->
  <script>
    import {
      createIcons,
      // 生产图标（10 静态 + 5 来自 config.yaml 动态绑定）
      User, Code2, Palette, Bell, ArrowRight,
      Sun, Moon, MoonStar, CloudMoon, Star, Clock, Scale,
      Send, Feather, Box, FileText, PenTool,
      // dev 图标（仅 EditPanel 使用，生产构建被 tree-shake）
      Settings2, SlidersHorizontal, X, Trash2,
      Image as ImageIcon, Plus, Check, Save,
    } from 'lucide';

    const icons = {
      User, Code2, Palette, Bell, ArrowRight,
      Sun, Moon, MoonStar, CloudMoon, Star, Clock, Scale,
      Send, Feather, Box, FileText, PenTool,
    };

    // dev 模式下加入编辑面板图标，统一由 DefaultLayout 的 createIcons 渲染
    // 避免EditPanel单独调用createIcons遍历全页导致"icon not found"警告
    if (import.meta.env.DEV) {
      Object.assign(icons, {
        Settings2, SlidersHorizontal, X, Trash2,
        Image: ImageIcon, Plus, Check, Save,
      });
      // 暴露重渲染函数供 EditPanel 的 addItem 克隆元素后调用
      window.__recreateIcons = () => createIcons({ icons });
    }

    createIcons({ icons });
  </script>
  <!-- 悬浮导航滚动状态：监听滚动切换导航透明度与阴影 -->
  <script is:inline src="/scripts/nav-scroll.js" defer></script>
</body>
</html>
